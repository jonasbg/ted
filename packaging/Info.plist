			<key>CFBundleTypeName</key>
			<string>Web page</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.html</string>
			</array>
		</dict>
		<!-- Files macOS knows nothing about are public.data: Dockerfile,
		     Containerfile, LICENSE, .gitignore, .env and other dotfiles. No
		     app can claim a file by its name, so ted is offered in "Open With"
		     for them (Get Info > Open with > Change All makes it stick).
		     Binary files are refused when opened. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Extensionless text file</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
		<!-- .ts is registered as MPEG-2 transport stream video, so TypeScript
		     is offered in "Open With" rather than claimed. -->
